{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "language": "korean",

  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },

  "permissions": {
    "allow": [
      "Bash(cmake --build *)",
      "Bash(cmake --preset *)",
      "Bash(cmake -S *)",
      "Bash(cmake -B *)",
      "Bash(ctest --preset *)",
      "Bash(ctest --test-dir *)",
      "Bash(clang-format *)",
      "Bash(clang-tidy *)",
      "PowerShell(cmake --build *)",
      "PowerShell(cmake --preset *)",
      "PowerShell(cmake -S *)",
      "PowerShell(cmake -B *)",
      "PowerShell(ctest --preset *)",
      "PowerShell(ctest --test-dir *)",
      "PowerShell(clang-format *)",
      "PowerShell(clang-tidy *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.*)",
      "Edit(**/.env.*)",
      "Edit(!.env.example)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  },

  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/statusline.mjs"
  }
}
