# 저장소에는 LF 로 저장하고, 체크아웃할 때 OS 규칙을 따른다.
* text=auto

# 바이너리로 다뤄 diff/merge 에서 깨지지 않게 한다.
*.png binary
*.ico binary
*.pdf binary
*.gpkg binary
*.zip binary

# Windows 명령 파일은 CRLF 로 체크아웃한다(.bat/.cmd 는 LF 이면 라벨·goto 가 깨질 수 있다).
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Claude Code 훅·상태줄(Node)은 어느 OS 에서나 LF 로 둔다.
.claude/hooks/*.mjs text eol=lf

*.qgz binary
